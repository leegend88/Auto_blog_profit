# Core
PROJECT_NAME=Auto_blog_profit
BLOG_PLATFORM=blogger
BLOG_TIMEZONE=Asia/Seoul
PUBLISH_SCHEDULE=09:00

# Topic
PRIMARY_NICHE=ai_productivity_tools
TARGET_LANGUAGE=ko
TARGET_COUNTRY=KR

# Keyword Strategy
KEYWORD_SEED_TOPICS=chatgpt,gemini,ai productivity,ai workflow,ai tools
KEYWORD_FETCH_LIMIT=20
KEYWORD_SCORE_MIN=70

# LLM / Content
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
ENABLE_SECOND_PASS_REWRITE=true
OPENAI_TIMEOUT_SECONDS=120
QUALITY_MIN_SCORE=70
RUN_LOG_PATH=logs/runs.jsonl
RECENT_POST_CHECK_LIMIT=20
ENABLE_INLINE_IMAGES=true
MAX_SECTION_CARDS=3
IMAGE_OUTPUT_DIR=public/generated-images
PUBLIC_IMAGE_BASE_URL=

# Blogger
BLOGGER_BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# SEO / Analytics
GA4_MEASUREMENT_ID=
SEARCH_CONSOLE_SITE_URL=

# Affiliate
ENABLE_COUPANG_PARTNERS=false
COUPANG_PARTNERS_ID=

# Safety
ENABLE_HUMAN_REVIEW=true
MAX_POSTS_PER_DAY=1
BLOCK_SENSITIVE_TOPICS=true
